# Site (used for canonical URLs, sitemap, OG tags, llms.txt)
NEXT_PUBLIC_SITE_URL=https://geo-report.fusionsync.ai

# Database
DATABASE_URL=postgresql://geo:geo@db:5432/geo_reports

# Cursor agent (required in Docker for headless auth)
CURSOR_API_KEY=cursor_...

# Agent settings
CURSOR_AGENT_BIN=cursor-agent
CURSOR_AGENT_MODEL=auto
CURSOR_AGENT_AUTO_APPROVE=1
CURSOR_AGENT_APPROVE_MCPS=1

# Paths
DATA_DIR=/data
GEO_SKILL_PATH=/app/geo-skill
CHROME_BIN=chromium

# Concurrency
MAX_CONCURRENT_AUDITS=2

# Default branding (FusionSync AI)
DEFAULT_BRAND_NAME=FusionSync AI
DEFAULT_ACCENT_COLOR=#2563eb
DEFAULT_BRAND_CONTACT=https://www.fusionsync.ai

# Email notifications (optional; if unset, the notify feature is disabled)
# Get a key at https://resend.com and verify your sending domain.
RESEND_API_KEY=
EMAIL_FROM=FusionSync GEO <reports@geo-report.fusionsync.ai>

# Admin API secret — sent as the `authorization` header to read /api/v1/admin/reports.
# If unset, the admin API is disabled (returns 401).
API_SECRET=
